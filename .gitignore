# Code-signing certificates and environment secrets. Nothing here yet, but a
# leaked .pfx at packaging time is not recoverable.
*.pfx
*.p12
*.pem
*.key
*.cer
.env
.env.*

# Art sources are large binaries — keep them out of git history and use
# dedicated asset storage (or Git LFS) instead. See doc/PROJECT_PLAN.md §3.3.
art/**/*.blend
art/**/*.blend1
art/**/*.psd
art/**/*.spp
